# 複製成 .env（本機）或到部署平台（Vercel）的環境變數介面填入。
# 這個檔案只放變數名稱與說明，不要填真實的密碼或金鑰。

# ---- 基本 ----
PORT=3005
# 前端網址，LINE Pay 範例與導向用
FRONTEND_URL=http://localhost:3000
# CORS 允許的來源，逗號分隔。雲端填前端網址，本機不填則使用 localhost 預設值
CORS_ORIGINS=http://localhost:3000
# WebSocket 網址（本機用）。Vercel 不支援，正式環境要改用 Supabase Realtime 或輪詢
WS_URL=ws://localhost:3005

# ---- 資料庫（開發與正式環境共用同一組變數名稱）----
# 本機：postgresql://postgres:密碼@localhost:5432/project_db
# 雲端：Supabase 的連線字串（Vercel 建議用 Transaction pooler，port 6543）
DATABASE_URL=
# 雲端資料庫的 CA 憑證 PEM 內容，換行可寫成 \n。本機不要填（不使用 SSL）
DATABASE_CA_CERT=

# ---- 認證與加密 ----
ACCESS_TOKEN_SECRET=
OTP_SECRET=

# ---- 寄信 ----
SMTP_TO_EMAIL=
SMTP_TO_PASSWORD=
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ---- LINE 登入 ----
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_LOGIN_CALLBACK_URL=
SHIP_711_STORE_CALLBACK_URL=

# ---- LINE Pay ----
LINE_PAY_CHANNEL_ID=
LINE_PAY_CHANNEL_SECRET=
REACT_REDIRECT_CONFIRM_URL=
REACT_REDIRECT_CANCEL_URL=

# ---- 綠界 ECPay ----
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=
ECPAY_TEST=true
ECPAY_RETURN_URL=
ECPAY_ORDER_RESULT_URL=
ECPAY_ORDER_CALLBACK_URL=
