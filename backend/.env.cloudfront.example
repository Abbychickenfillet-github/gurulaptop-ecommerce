# 免費圖片託管服務配置

# ==========================================
# Cloudinary (推薦 - 最慷慨的免費額度)
# ==========================================
# 免費額度：25,000張圖片/月 + 25GB流量/月
# 申請地址：https://cloudinary.com/
# 1. 註冊 Cloudinary 帳號
# 2. 在 Dashboard 找到 Cloud Name
# 3. 在 Upload 設定中創建 Upload Preset (設為 Unsigned)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUD Binary_UPLOAD_PRESET=your_upload_preset

# ==========================================
# ImgBB API (最簡單，無限制)
# ==========================================
# 免費額度：無限制數量，32MB/圖片
# 申請地址：https://api.imgbb.com/
# 1. 註冊帳號獲取 API Key
IMGBB_API_KEY=your_imgbb_api_key

# ==========================================
# Cloudflare Images (企業級服務)
# ==========================================
# 免費額度：100,000張圖片/月，不限流量
# 申請地址：https://www.cloudflare.com/products/cloudflare-images/
# 需要有 Cloudflare 帳號和已驗證的域名
CLOUDFLARE_API_TOKEN=your_cloudflare_token
CLOUDFLARE_ACCOUNT_ID=your_account_id

# ==========================================
# AWS 配置 (可選 - 需要信用卡，有免費額度)
# ==========================================
# 首年免費額度很大，但需要信用卡驗證
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=your_bucket_name
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
CLOUDFRONT_DOMAIN=https://d1234567890.cloudfront.net
